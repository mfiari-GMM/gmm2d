  - m_Id: 7768949699317760
    m_Localized: Potion
    m_Metadata:
      m_Items: []
  - m_Id: 7769109481328640
    m_Localized: Potion de Mana
    m_Metadata:
      m_Items: []
  - m_Id: 7769171250843648
    m_Localized: Restore 50 PM
    m_Metadata:
      m_Items: []
  - m_Id: 7770203896877056
    m_Localized: Armure de fer
    m_Metadata:
      m_Items: []
  - m_Id: 7770240504762368
    m_Localized: Armure basique en fer.
    m_Metadata:
      m_Items: []
  - m_Id: 7770369924206592
    m_Localized: Armure de cuir
    m_Metadata:
      m_Items: []
  - m_Id: 7770431655972864
    m_Localized: armure faite en cuir, pas tres solide. Ideal pour les debutants
    m_Metadata:
      m_Items: []
  - m_Id: 7772943037435904
    m_Localized: Armure acier
    m_Metadata:
      m_Items: []
  - m_Id: 7773152228347904
    m_Localized: Armure en acier
    m_Metadata:
      m_Items: []
  - m_Id: 7775645528166400
    m_Localized: APPLE
    m_Metadata:
      m_Items: []
  - m_Id: 7775769042030592
    m_Localized: STRAWBERRY
    m_Metadata:
      m_Items: []
  - m_Id: 7780024503177216
    m_Localized: 'Tous le monde gagne '
    m_Metadata:
      m_Items: []
  - m_Id: 7780824554082304
    m_Localized: 'Vous recevez '
    m_Metadata:
      m_Items: []
  - m_Id: 7899895316549632
    m_Localized: HEALTH_POTION
    m_Metadata:
      m_Items: []
  - m_Id: 7908121646927872
    m_Localized: Feu
    m_Metadata:
      m_Items: []
  - m_Id: 7916009077542912
    m_Localized: 'Obtenu '
    m_Metadata:
      m_Items: []
  - m_Id: 7918670904496128
    m_Localized: "Ce combat n'\xE9tait pas facile."
    m_Metadata:
      m_Items: []
  - m_Id: 7918758120853504
    m_Localized: Oui, heureusement que tu etait la Mok.
    m_Metadata:
      m_Items: []
  - m_Id: 7918916350971904
    m_Localized: Il est temps de rentrer se reposer pour notre examen de demain.
    m_Metadata:
      m_Items: []
  - m_Id: 7919250045603840
    m_Localized: Tu as raison, allons-y !
    m_Metadata:
      m_Items: []
  - m_Id: 7919404102389760
    m_Localized: Avant, prennez ces potions pour vous soignez.
    m_Metadata:
      m_Items: []
  - m_Id: 7919595379429376
    m_Localized: Merci !
    m_Metadata:
      m_Items: []
  - m_Id: 7923486737240064
    m_Localized: Chevalier
    m_Metadata:
      m_Items: []
  - m_Id: 7927097412227072
    m_Localized: Coup d'estoc
    m_Metadata:
      m_Items: []
  - m_Id: 7927175258509312
    m_Localized: Estocade sonique
    m_Metadata:
      m_Items: []
  - m_Id: 7927212969496576
    m_Localized: Estocade supersonique
