  - m_Id: 3898941254094848
    m_Localized: Use
    m_Metadata:
      m_Items: []
  - m_Id: 3898968965861376
    m_Localized: Discard
    m_Metadata:
      m_Items: []
  - m_Id: 3899014151098368
    m_Localized: For who ?
    m_Metadata:
      m_Items: []
  - m_Id: 3899169596198912
    m_Localized: Save in progress, do not turn off !
    m_Metadata:
      m_Items: []
  - m_Id: 3899368884359168
    m_Localized: Buy
    m_Metadata:
      m_Items: []
