      value: n-Femme
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[1]
      value: Bienvenue a Silverwood
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[2]
      value: Venez vous reposer dans notre auberge.
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[3]
      value: Et n'oubliez pas de passer a la boutique.
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[4]
      value: n-Homme
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[5]
      value: D'accord. Je demande car les soldats de Moonshine sont a la recherche
        de fugitifs.
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[6]
      value: n-Marco
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[7]
      value: Hum... je vois
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[8]
      value: n-Homme
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[9]
      value: C'est bon, allez-y
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: shouldActivateQuest
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
