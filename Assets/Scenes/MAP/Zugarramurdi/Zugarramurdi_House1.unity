    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[8]
      value: "Il semblerai que mes invit\xE9s soient arriv\xE9s"
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[9]
      value: "Nous reparlerons de \xE7a plus tard."
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: shouldActivateQuest
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[10]
      value: A bientot Ryujin, mon ami.
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[11]
      value: n-Ryujin
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[12]
      value: "A bient\xF4t Cassandre."
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[13]
      value: Je connais bien, ce genre de blessure.
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[14]
      value: "Il y a longtemps, ces armes ont \xE9t\xE9 utilis\xE9 en temps de guerre."
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[15]
      value: Je ne pensais pas qu'il en restait encore.
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[16]
      value: n-Vard
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[17]
      value: "Ce doit \xEAtre des armes tr\xE8s ancienne, car je n'en ai jamais entendu
        parler."
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[18]
      value: n-Cassandre
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[19]
      value: En effet.
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[20]
      value: Mais nous parlerons plus tard, le temps presse.
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[21]
      value: "Le rem\xE8de que vous chercher se trouve dans la foret."
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[22]
      value: Cynthia vous accompagnera.
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[23]
      value: Mais avant cela, je dois lui parler.
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[24]
      value: "Elle vous rejoindra devant l'entr\xE9e de la foret au nord de la ville."
      objectReference: {fileID: 0}
    - target: {fileID: 3096401618692413003, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: lines.Array.data[25]
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6066342711227365786, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: m_Name
      value: Hecate
      objectReference: {fileID: 0}
    - target: {fileID: 8423902859190488733, guid: 1c0570faa84b24e4ba49d4d899d04927,
        type: 3}
      propertyPath: m_SpriteTilingProperty.oldSize.x
